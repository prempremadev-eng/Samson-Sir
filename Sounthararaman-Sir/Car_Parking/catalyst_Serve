Un index.js la paaru:

module.exports = (req, res) => {          // 📖 Recipe start
  var url = req.url;                       //    "customer enna order pannaar?"
  switch (url) {
    case '/':
      res.writeHead(200, {...});           //    "plate ready pannu"
      res.write('<h1>Hello from index.js<h1>');  // 🥞 ← idhu dhaan dosai
      break;
    default:
      res.writeHead(404);                  //    "andha dish illa"
      res.write('You might find...');
  }
  res.end();                               //    "plate-a kudu"
};                                         // 📖 Recipe end

